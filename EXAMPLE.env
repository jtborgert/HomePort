# HomePort Configuration & Test Environment Variables
# Copy this file to .env and configure your Homey Pro or Athom Cloud credentials
# to run tests and operations against a real backend.

# Direct connection to Homey Pro (Local IP, Local Secure URL, or Remote URL)
# Example: http://192.168.1.50 or https://192-168-1-50.homey.homeylocal.com
HOMEY_BASE_URL=http://192.168.1.50

# Homey Pro Direct Session Token / API Key
HOMEY_SESSION_TOKEN=your_homey_api_key_or_session_token_here

# Athom Cloud OAuth2 Client credentials (optional)
HOMEY_CLIENT_ID=your_client_id_here
HOMEY_CLIENT_SECRET=your_client_secret_here

# Athom Cloud tokens (optional)
HOMEY_ACCESS_TOKEN=
HOMEY_REFRESH_TOKEN=
HOMEY_DELEGATION_TOKEN=

# User Profile details (optional)
HOMEY_USERNAME=
HOMEY_EMAIL=

# SSL Verification (set to false for self-signed certificates on local IP)
HOMEY_VERIFY_SSL=true

# Preferred connection mode: auto, local_secure, local, remote
HOMEY_CONNECTION_MODE=auto
